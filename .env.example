# Copy to .env and edit — the real .env is git-ignored (design §9).
# All values below are LOCAL DEV defaults; change every password before real use.

# --- PostgreSQL (one instance, one schema per service — ADR-003) ---
POSTGRES_USER=wallet_admin
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_DB=wallet_platform
# per-service roles, created by infra/postgres/init/01-init.sh on first boot
USER_SERVICE_DB_PASSWORD=change-me-user-service
WALLET_SERVICE_DB_PASSWORD=change-me-wallet-service
LEDGER_SERVICE_DB_PASSWORD=change-me-ledger-service
# keycloak's own store lives in the `keycloak` schema on the same instance
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# --- Keycloak (bootstrap admin, http://localhost:8180 in dev) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
